# Default: local workspace, no exposed account registration.
LEOTREE_EMAIL_AUTH=false
# To enable an optional persistent local email/password account:
# npm run setup:account
# This creates .env.local with a random secret and .local/account-db storage.
# Restart the server afterwards. Knowledge is never stored in this account DB.
# One local server process per PGLite directory. Keep that directory and secret.

# Optional public feedback destination; leave blank until a real HTTPS URL is available.
VITE_FEEDBACK_URL=
