[Unit]
Description=Renew Leo Tree IP certificate and reload nginx
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment="HTTP_PROXY=" "HTTPS_PROXY=" "ALL_PROXY=" "http_proxy=" "https_proxy=" "all_proxy="
ExecStart=/opt/leotree/certbot/bin/certbot renew --quiet --deploy-hook "/usr/bin/systemctl reload nginx"
